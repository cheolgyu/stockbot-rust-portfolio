FROM 000000000000.dkr.ecr.ap-northeast-2.amazonaws.com/stockbot-base:latest as base

ENV PROJECT=hello


ARG SCCACHE_BUCKET
ARG SCCACHE_S3_KEY_PREFIX
ARG AWS_ACCESS_KEY_ID
ARG AWS_SECRET_ACCESS_KEY
ARG SCCACHE_REGION

ENV SCCACHE_BUCKET=${SCCACHE_BUCKET}
ENV SCCACHE_S3_KEY_PREFIX=${SCCACHE_S3_KEY_PREFIX}
ENV AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
ENV AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
ENV SCCACHE_REGION=${SCCACHE_REGION}

RUN export \
    && sccache --version


WORKDIR /stockbot
COPY hello hello

WORKDIR /stockbot/hello
# 빌드는 성공 테스트필요. batch 테스트 결과 운영 실패 . 인증서 필요.
# RUN cargo build  --target aarch64-unknown-linux-gnu --features vendored-openssl
RUN cargo build  --target aarch64-unknown-linux-gnu --features rustls


FROM arm64v8/ubuntu as run

WORKDIR /stockbot
COPY --from=base /stockbot/hello . 
#.env.batch_plan는 docker run 하는 스크립트에서 넣어줌

CMD [ "./hello" ]

