
### 네이버 차트 에서 가격조회 . 조회한 가격이 다름.
https://api.finance.naver.com/siseJson.naver?symbol=044480&requestType=1&startTime=20250801&endTime=20250901&timeframe=day


### KRX PRICE 엑셀다운로드 
### 조회 가능한 시작 기간은 1995-05-02 데이터.
### 최대 조회 기간은 2년 미만임으로 -1일 해야함.
# 파리미터 
# bld=dbms/MDC/STAT/standard/MDCSTAT01701
# locale=ko_KR
# tboxisuCd_finder_stkisu0_0=37550L/DL이앤씨2우(전환)
# isuCd=KR737550K029
    # 검색한 종목의 표준코드
# isuCd2=KR7005930003
    # 검색전 표준코드? KR7005930003: 삼성전자 보통주 기본값
# codeNmisuCd_finder_stkisu0_0=DL이앤씨2우(전환)
# param1isuCd_finder_stkisu0_0=ALL
# strtDd=20250916
# endDd=20250924
# adjStkPrc_check=Y
    # 수정주가 적용 
# adjStkPrc=2
    # 수정주가 적용값 , 적용하면 2 안하면 1 
# share=1
    #주단위 1:주 2: 천주 3: 백만주
# money=1
    # 1: 원 2:천원 3: 백만원 4 :십억원
# csvxls_isNo=false
# name=fileDown
# url=dbms/MDC/STAT/standard/MDCSTAT01701
# 
# tboxisuCd_finder_stkisu0_1 차이는 ?
# 코스피 DL이앤씨2우(전환)  신형우선주 tboxisuCd_finder_stkisu0_3
# 코넥스 211270/AP위성   보통주 tboxisuCd_finder_stkisu0_1 
# 코스피 004415/서울식품우 구형우선주 tboxisuCd_finder_stkisu0_1
# 코스닥 tboxisuCd_finder_stkisu0_1=311690/CJ 바이오사이언스
# 
POST https://data.krx.co.kr/comm/fileDn/GenerateOTP/generate.cmd
content-type: application/x-www-form-urlencoded; charset=UTF-8

locale=ko_KR&tboxisuCd_finder_stkisu0_1=001530/DI동일&isuCd=KR7001530005&isuCd2=KR7001530005&codeNmisuCd_finder_stkisu0_1=DI동일&param1isuCd_finder_stkisu0_1=ALL&strtDd=19950502&endDd=19970501&adjStkPrc_check=Y&adjStkPrc=2&share=1&money=1&csvxls_isNo=false&name=fileDown&url=dbms/MDC/STAT/standard/MDCSTAT01701
